# Legado. O assistente e o agente OFSC usam XAI_API_KEY / XAI_MODEL.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Assistente (/assistente) e agente OFSC (/integracao).
# Sem chave, ambos ficam no modo sem IA (regras determinísticas).
# Copie este ficheiro para .env.local e preencha a chave.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning

# Segredo partilhado para o webhook OFSC e o simulador `/api/ofsc/...`.
# Cabeçalho: x-vagacerta-ofsc-secret (ou Authorization: Bearer …).
# Em produção defina um valor longo e aleatório (sem esta variável o serviço responde 503).
# Fora de produção, sem valor, usa o segredo de demonstração abaixo.
OFSC_WEBHOOK_SECRET=vagacerta-demo-ofsc

# Demonstração — fixa o «dia rico» (AAAA-MM-DD). Sem esta variável é hoje em Lisboa (fim de semana → segunda-feira).
# Só tem efeito quando a base é semeada (npm run demo:reset para voltar a semear).
# VC_DEMO_DIA=
