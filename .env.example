# Opcional. O assistente de linguagem natural ainda não está ligado.
# Quando existir, a ausência de chave obriga o fallback determinístico.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Integração OFSC — agente do operador (Grok / xAI).
# Sem chave, o ecrã /integracao usa o interpretador determinístico (modo sem IA).
# Copie este ficheiro para .env.local e preencha a chave.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning

# Integração OFSC — segredo partilhado do webhook (POST /api/integracao/ofsc/eventos) e do OFSC simulado (/api/ofsc/...).
# Vai no cabeçalho x-vagacerta-segredo ou em Authorization: Bearer. Sem esta variável, a aplicação gera um segredo de
# desenvolvimento e guarda-o só na base local (nunca é impresso). Em produção, defina um valor longo e aleatório.
# VC_OFSC_SEGREDO=

# Demonstração — fixa o «dia rico» (AAAA-MM-DD). Sem esta variável é hoje em Lisboa (fim de semana → segunda-feira).
# Só tem efeito quando a base é semeada (npm run demo:reset para voltar a semear).
# VC_DEMO_DIA=
